# ---------------------------------------------------------------------------
# OmniStock environment template.
#
#   cp .env.example .env        # 然后修改标注「必须修改」的项
#
# .env 已被 git 忽略：里面有 JWT 签名密钥和数据库口令，绝不要提交。
# ---------------------------------------------------------------------------
APP_NAME=OmniStock
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# 默认 SQLite，小团队零运维即可跑起来。
# 生产建议换 PostgreSQL（库存行锁更可靠）：
#   postgresql+psycopg://omnistock:CHANGE_ME@localhost:5432/omnistock
DATABASE_URL=sqlite:///./omnistock.db
SQL_ECHO=false

# 必须修改：至少 32 字符的随机串。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TTL_MINUTES=30
AUTH_REFRESH_TTL_DAYS=7
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_PBKDF2_ROUNDS=120000

# 首次启动创建的管理员
DEFAULT_ADMIN_USERNAME=admin
# 必须修改：登录后请立即改密
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
DEFAULT_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------ 商品与库存
SKU_CODE_PREFIX=SKU
SPU_CODE_PREFIX=SPU
# 首次启动自动创建的总仓
DEFAULT_WAREHOUSE_CODE=WH-MAIN
DEFAULT_WAREHOUSE_NAME=总仓
# 是否允许库存为负。默认 false：不足即报错，绝不静默写坏数据。
INVENTORY_ALLOW_NEGATIVE=false
# 是否拒绝数量为 0 的库存调整
INVENTORY_REJECT_ZERO_DELTA=true
CURRENCY=CNY

# ------------------------------------------------------------------ 渠道与订单
# 缺货处理策略：exception = 整单不占用并转异常（默认）；partial = 先占能占的
ORDER_SHORTAGE_STRATEGY=exception
# 渠道导出文件里若没有 paid_at，是否视为已付款并立即占用库存
ORDER_IMPORT_ASSUME_PAID=true
# 单次导入的订单数上限与文件编码（utf-8-sig 可吃掉 Excel 的 BOM）
IMPORT_MAX_ROWS=5000
IMPORT_ENCODING=utf-8-sig
ORDER_CODE_PREFIX=SO
ORDER_SYNC_BATCH_SIZE=200

# ------------------------------------------------------------------ 仓库发货
SHIPMENT_CODE_PREFIX=SHP
# 是否强制扫码拣货（false 时可以直接手工确认）
PICK_REQUIRE_BARCODE=true
# 是否允许短拣发货。默认 false：没拣完就卡住，绝不悄悄少发。
# 开启后会按实际拣到的数量出库，未发部分自动释放占用。
SHIPMENT_ALLOW_PARTIAL_PICK=false

# --------------------------------------------------------------------- logs
LOG_LEVEL=INFO
# true 输出 JSON 行日志（交给 Loki/ELK）；false 输出可读文本
LOG_JSON=false
# 留空表示输出到标准输出
LOG_FILE=
LOG_ACCESS=true

# -------------------------------------------------------------------- runtime
# development | testing | production；production 下 /docs 默认关闭
EXPOSE_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ------------------------------------------------------- docker compose 专用
HTTP_PORT=8080
# 容器内的数据库地址（覆盖上面的 DATABASE_URL）
DATABASE_URL_OVERRIDE=sqlite:///./storage/omnistock.db
# 使用 --profile postgres 时设置
POSTGRES_DB=omnistock
POSTGRES_USER=omnistock
POSTGRES_PASSWORD=
# 为 true 时容器启动会写入演示种子数据
SEED_DEMO_DATA=false
